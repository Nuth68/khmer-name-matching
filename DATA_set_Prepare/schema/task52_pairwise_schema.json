{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task52 Pairwise Name Matching Dataset",
  "description": "Schema for pairwise Khmer name/identity matching labeled dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pair_id",
    "left_record_id",
    "right_record_id",
    "left_full_name_kh",
    "right_full_name_kh",
    "left_full_name_en",
    "right_full_name_en",
    "label",
    "label_status"
  ],
  "properties": {
    "pair_id": { "type": "string", "minLength": 1 },
    "left_record_id": { "type": "string", "minLength": 1 },
    "right_record_id": { "type": "string", "minLength": 1 },
    "left_full_name_kh": { "type": "string", "minLength": 1 },
    "right_full_name_kh": { "type": "string", "minLength": 1 },
    "left_full_name_en": { "type": "string", "minLength": 1 },
    "right_full_name_en": { "type": "string", "minLength": 1 },
    "left_dob": { "type": "string", "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$" },
    "right_dob": { "type": "string", "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$" },
    "left_gender": { "type": "string", "enum": ["Male", "Female", "Unknown", ""] },
    "right_gender": { "type": "string", "enum": ["Male", "Female", "Unknown", ""] },
    "left_phone": { "type": "string" },
    "right_phone": { "type": "string" },
    "left_province": { "type": "string" },
    "right_province": { "type": "string" },
    "left_doc_id": { "type": "string" },
    "right_doc_id": { "type": "string" },
    "left_source": { "type": "string" },
    "right_source": { "type": "string" },
    "label": { "type": "integer", "enum": [-1, 0, 1], "description": "-1=uncertain, 0=non_match, 1=match" },
    "label_status": { "type": "string", "enum": ["draft", "adjudicated", "verified"] },
    "label_reason": { "type": "string" },
    "labeled_by": { "type": "string" },
    "labeled_at": { "type": "string" },
    "dataset_split": { "type": "string", "enum": ["train", "val", "test", "benchmark", ""] }
  }
}
